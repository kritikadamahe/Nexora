# Copy this file to ".env" and fill in values. ".env" is git-ignored: never commit it.

# --- LLM (Groq). Leave empty to use the built-in rule-based fallbacks. ---
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-8b-instant
LLM_TIMEOUT=10

# --- Reddit (only needed when NEXORA_EXTERNAL_SIGNAL_MODE=reddit) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nexora

# --- External signal source ---
#   synthetic      : seeded placeholder generator (default; deterministic)
#   reddit         : live Reddit via PRAW (needs the credentials above)
#   legacy_neutral : reproduces nexora-v0 exactly (always NEUTRAL, urgency 0.25)
NEXORA_EXTERNAL_SIGNAL_MODE=synthetic

# Base seed for every stochastic component (synthetic signals, experiments).
NEXORA_SEED=42
